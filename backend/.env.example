VENDOROPS_MAX_UPLOAD_BYTES=10485760
VENDOROPS_BACKEND_URL=http://127.0.0.1:8000
VENDOROPS_REQUEST_TIMEOUT_SECONDS=60
VENDOROPS_DATA_DIR=backend/data
VENDOROPS_PROVIDER=fixture
VENDOROPS_OPERATOR=demo-operator
VENDOROPS_RECIPIENT_ALLOWLIST=reviewer@example.test
VENDOROPS_LIVE_CALLS_ENABLED=false
VENDOROPS_LIVE_SEND_ENABLED=false
VENDOROPS_APPROVED_MONTHLY_BUDGET_USD=0
VENDOROPS_AWS_REGION=us-east-1
# Optional named profile for native local runs; leave empty on EC2 to use its instance role.
VENDOROPS_AWS_PROFILE=
VENDOROPS_BEDROCK_REGION=us-east-1
VENDOROPS_MODEL_ID=amazon.nova-lite-v1:0
VENDOROPS_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
VENDOROPS_OCR_PROVIDER=local
VENDOROPS_TESSERACT_COMMAND=tesseract
VENDOROPS_OCR_PAGE_TIMEOUT_SECONDS=60
VENDOROPS_DAILY_MODEL_CALLS=50
VENDOROPS_DAILY_OCR_JOBS=5
VENDOROPS_DAILY_EMAIL_SENDS=5
VENDOROPS_MAX_DOCUMENT_PAGES=20
VENDOROPS_MAX_MODEL_CHARACTERS=24000
VENDOROPS_MAX_OUTPUT_TOKENS=2000
VENDOROPS_STORAGE_MODE=local
VENDOROPS_S3_BUCKET=
VENDOROPS_SNS_TOPIC_ARN=
VENDOROPS_TEXTRACT_ROLE_ARN=
VENDOROPS_SQS_QUEUE_URL=
VENDOROPS_SES_SENDER=
VENDOROPS_LOG_GROUP=
# Use sqlite for exact local vector retrieval if native Chroma dependencies are unavailable.
VENDOROPS_VECTOR_STORE=chroma
